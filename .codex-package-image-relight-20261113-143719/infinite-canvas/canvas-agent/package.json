{
  "name": "@basketikun/canvas-agent",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "canvas-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "agent-instructions.md",
    "dsh-ark-agent-plan.patch.yml",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "debug": "tsx src/index.ts --debug",
    "test": "tsx --test src/config.test.ts src/canvas/operations.test.ts src/canvas/session.test.ts src/agent/codex-client.test.ts src/agent/codex-history.test.ts src/agent/deepseek.test.ts src/agent/canvas-channel.test.ts src/agent/message-metadata.test.ts src/skills/store.test.ts src/utils/agent-runtime.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "strip-ansi": "7.2.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@openai/codex": "0.146.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
