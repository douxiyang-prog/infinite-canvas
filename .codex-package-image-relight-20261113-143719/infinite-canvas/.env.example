# MySQL 数据库，需要提前创建 MYSQL_DATABASE。
MYSQL_HOST=replace-with-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=infinite_canvas
MYSQL_USER=replace-with-mysql-user
MYSQL_PASSWORD=replace-with-a-strong-password

# 管理员只能在这些容器可见目录内配置画布存储路径。
CANVAS_STORAGE_HOST_ROOT=/mnt/smb
CANVAS_STORAGE_CONTAINER_ROOT=/mnt/smb
CANVAS_STORAGE_ALLOWED_ROOTS=/mnt/smb

# 用于加密数据库中的全局配置、API Key 和 WebDAV 凭据。
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret
CANVAS_PUBLIC_BASE_URL=https://your-oray-domain.example.com
CANVAS_PUBLIC_FILE_TTL_SECONDS=86400

# 登录会话有效期和 Cookie。
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# 仅在用户表为空时创建首个管理员；创建成功后可以删除这两项。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=管理员

# 可选统计分析配置。
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
